###  https://l-jamora.github.io/sdco#BDC2_Z
:BDC2_Z rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BDC
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization2> ;
                                                     owl:hasValue "Z"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BDC ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTerminationReason ;
                          owl:someValuesFrom :OtherCause
                        ] ;
        rdfs:comment "other (Z) – where this is used further details shall be recorded in the remarks section." ;
        rdfs:label "BDC char2=Z (Other Cause)"@en .


###  https://l-jamora.github.io/sdco#BDD
