:DDG_Z rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :DDG
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "Z"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :DDG ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasObstructionReason ;
                         owl:someValuesFrom :OtherCause
                       ] ;
       rdfs:label "DDG char1=Z (Other Cause)"@en .


