###  https://l-jamora.github.io/sdco#CrossSection
:CrossSection rdf:type owl:Class ;
              rdfs:subClassOf :Inventory ;
              rdfs:comment """Used to describe DCO.

DCO Characterisation The shape of the horizontal (plan) cross-section of the manhole or inspection  chamber as follows:  circular (A); rectangular (B);  local section - code to be specified by the employing authority and prefixed by an X (e.g. XA);  !other (Z) – where this is used"""@en ;
              rdfs:label "Cross Section"@en .


###  https://l-jamora.github.io/sdco#DAA
:DAA rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "DAA"
                         ] ;
     rdfs:subClassOf :NodeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasNodeFabricDamage ;
                       owl:someValuesFrom :Deformation
                     ] ;
     rdfs:label "DAA (Deformation)"@en .


###  https://l-jamora.github.io/sdco#DAA_A
:DAA_A rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :DAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "A"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :DAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasNodeFabricDamage ;
                         owl:someValuesFrom :GeneralDeformation
                       ] ;
       owl:disjointWith :DAA_B ;
       rdfs:label "DAA char1=A (General Deformation)"@en .


###  https://l-jamora.github.io/sdco#DAA_B
:DAA_B rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :DAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "B"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :DAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasNodeFabricDamage ;
                         owl:someValuesFrom :LocalisedDeformation
                       ] ;
       rdfs:label "DAA char1=B (Localised Deformation)"@en .


