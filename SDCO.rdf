@prefix : <https://l-jamora.github.io/sdco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://l-jamora.github.io/sdco#> .

<https://l-jamora.github.io/sdco> rdf:type owl:Ontology ;
                                   owl:imports <https://l-jamora.github.io/m150-onto> ;
                                   rdfs:label "Sewer Damage Classification Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://l-jamora.github.io/sdco#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasConnectionDischargeDirection
:hasConnectionDischargeDirection rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdf:type owl:AsymmetricProperty ,
                                          owl:IrreflexiveProperty ;
                                 rdfs:comment """For DCG char2:

Whether the connection is incoming or outgoing or has been sealed:  connection discharges into the manhole or inspection chamber (A); connection discharges from the manhole or inspection chamber (B); connection closed (C)."""@en .


###  https://l-jamora.github.io/sdco#hasCost
:hasCost rdf:type owl:ObjectProperty .


###  https://l-jamora.github.io/sdco#hasCurvatureDirection
:hasCurvatureDirection rdf:type owl:ObjectProperty ;
                       rdfs:comment "Exclusively used for BCC Curvature of sewer char 1 and 2. Used to describe the horizontal and vertical direction of sewer curvature." .


###  https://l-jamora.github.io/sdco#hasDamage
:hasDamage rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasDamageCause
:hasDamageCause rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Defect ;
                rdfs:range :Cause .


###  https://l-jamora.github.io/sdco#hasDamageOrientation
:hasDamageOrientation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdf:type owl:FunctionalProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :Defect ;
                      rdfs:range :Orientation .


###  https://l-jamora.github.io/sdco#hasFeature
:hasFeature rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasFinishNodeType
:hasFinishNodeType rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasNodeType ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:comment "Exclusively made for BCE Finish node type." .


###  https://l-jamora.github.io/sdco#hasHorizontalCurvatureDirection
:hasHorizontalCurvatureDirection rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :hasCurvatureDirection ;
                                 rdf:type owl:AsymmetricProperty ,
                                          owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasInventoryFeature
:hasInventoryFeature rdf:type owl:ObjectProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:range :Inventory ;
                     rdfs:comment "Used to describe inventory codes for pipes and nodes." .


###  https://l-jamora.github.io/sdco#hasLocalizedRepair
:hasLocalizedRepair rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdf:type owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:comment "As of now exclusively used to describe location of Vermin. Has potential to further describe other codes however." .


###  https://l-jamora.github.io/sdco#hasNodeDamage
:hasNodeDamage rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDamage ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasNodeFabricDamage
:hasNodeFabricDamage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasNodeDamage ;
                     rdf:type owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasNodeFeature
:hasNodeFeature rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasFeature ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasNodeInventoryFeature
:hasNodeInventoryFeature rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasInventoryFeature ;
                         rdf:type owl:AsymmetricProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:range :Inventory .


###  https://l-jamora.github.io/sdco#hasNodeOperationDamage
:hasNodeOperationDamage rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasNodeDamage ;
                        rdf:type owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasNodeType
:hasNodeType rdf:type owl:ObjectProperty .


###  https://l-jamora.github.io/sdco#hasObstructionReason
:hasObstructionReason rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasPipeDamage
:hasPipeDamage rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDamage ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasPipeFabricDamage
:hasPipeFabricDamage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasPipeDamage ;
                     rdf:type owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasPipeFeature
:hasPipeFeature rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasFeature ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasPipeInventoryFeature
:hasPipeInventoryFeature rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasInventoryFeature ;
                         rdf:type owl:AsymmetricProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:range :Inventory .


###  https://l-jamora.github.io/sdco#hasPipeOperationDamage
:hasPipeOperationDamage rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasPipeDamage ;
                        rdf:type owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasStartNodeType
:hasStartNodeType rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasNodeType ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:comment "Exclusively made for BCD Start node type." .


###  https://l-jamora.github.io/sdco#hasTerminationReason
:hasTerminationReason rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasVerticalCurvatureDirection
:hasVerticalCurvatureDirection rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :hasCurvatureDirection ;
                               rdf:type owl:AsymmetricProperty ,
                                        owl:IrreflexiveProperty .


###  https://l-jamora.github.io/sdco#hasWater
:hasWater rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty .


#################################################################
#    Classes
#################################################################

###  https://l-jamora.github.io/sdco#AccesablePipeCoverMissing
:AccesablePipeCoverMissing rdf:type owl:Class ;
                           rdfs:subClassOf :OtherPipelineThroughManhole ;
                           rdfs:label "Accesable Pipe Cover Missing"@en .


###  https://l-jamora.github.io/sdco#AccessablePipeCoverInPlace
:AccessablePipeCoverInPlace rdf:type owl:Class ;
                            rdfs:subClassOf :OtherPipelineThroughManhole ;
                            rdfs:label "Accessable Pipe Cover In Place"@en .


###  https://l-jamora.github.io/sdco#AggregateProjectingFromSurface
:AggregateProjectingFromSurface rdf:type owl:Class ;
                                rdfs:subClassOf :Surface ;
                                rdfs:label "Aggregate Projecting From Surface"@en .


###  https://l-jamora.github.io/sdco#Angular
:Angular rdf:type owl:Class ;
         rdfs:subClassOf :Orientation ;
         rdfs:comment "Used by BAJ Displaced Joint" ;
         rdfs:label "Angular"@en .


###  https://l-jamora.github.io/sdco#AnotherObjectObstacle
:AnotherObjectObstacle rdf:type owl:Class ;
                       rdfs:subClassOf :Obstacle ;
                       rdfs:label "Another Object Obstacle"@en .


###  https://l-jamora.github.io/sdco#ArchShapedConnectingPipeline
:ArchShapedConnectingPipeline rdf:type owl:Class ;
                              rdfs:subClassOf :ConnectingPipeline ;
                              rdfs:label "Arch Shaped Connecting Pipeline"@en .


###  https://l-jamora.github.io/sdco#AtmosphereWithin
:AtmosphereWithin rdf:type owl:Class ;
                  rdfs:subClassOf :OtherObservation ;
                  rdfs:label "Atmosphere Within"@en .


###  https://l-jamora.github.io/sdco#AttachedDeposits
:AttachedDeposits rdf:type owl:Class ;
                  rdfs:subClassOf :OperationalDefect ;
                  rdfs:label "Attached Deposits"@en .


###  https://l-jamora.github.io/sdco#AuthorityInstruction
:AuthorityInstruction rdf:type owl:Class ;
                      rdfs:subClassOf :Cause ;
                      rdfs:label "Authority Instruction"@en .


###  https://l-jamora.github.io/sdco#BAA
:BAA rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BAA"
                         ] ;
     rdfs:subClassOf :PipeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFabricDamage ;
                       owl:someValuesFrom :Deformation
                     ] ;
     rdfs:label "BAA (Deformation)"@en .


###  https://l-jamora.github.io/sdco#BAA_A
:BAA_A rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :BAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "A"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :BAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDamageOrientation ;
                         owl:someValuesFrom :Vertical
                       ] ;
       owl:disjointWith :BAA_B ;
       rdfs:label "BAA char1=A (Vertical)"@en .


###  https://l-jamora.github.io/sdco#BAA_B
:BAA_B rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :BAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "B"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :BAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDamageOrientation ;
                         owl:someValuesFrom :Horizontal
                       ] ;
       rdfs:label "BAA char1=B (Horizontal)"@en .


###  https://l-jamora.github.io/sdco#BAB
:BAB rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BAB"
                         ] ;
     rdfs:subClassOf :PipeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFabricDamage ;
                       owl:someValuesFrom :Fissure
                     ] ;
     rdfs:comment """BAB = Pipe Fissure Damage
Char1: Nature of the Fissure
Char2: Orientation of the Fissure
Quantification: Width in millimeters
Circumferntial Location: Should be recorded""" ;
     rdfs:label "BAB (Fissure)"@en .


###  https://l-jamora.github.io/sdco#BAB1_A
:BAB1_A rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "A"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :SurfaceCrackFissure
                        ] ;
        rdfs:label "BAB char1=A (Surface Crack Fissure)"@en .


###  https://l-jamora.github.io/sdco#BAB1_B
:BAB1_B rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "B"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :CrackFissure
                        ] ;
        rdfs:label "BAB char1=B (Crack Fissure)"@en .


###  https://l-jamora.github.io/sdco#BAB1_C
:BAB1_C rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "C"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :FractureFissure
                        ] ;
        rdfs:label "BAB char1=C (Fracture Fissure)"@en .


