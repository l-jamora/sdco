@prefix : <http://www.semanticweb.org/jluis/ontologies/sdco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/jluis/ontologies/sdco#> .

<http://www.semanticweb.org/jluis/ontologies/sdco> rdf:type owl:Ontology ;
                                                    rdfs:label "Sewer Damage Classification Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/jluis/ontologies/sdco#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain <https://l-jamora.github.io/m150-onto#Component> ;
              rdfs:range <https://l-jamora.github.io/m150-onto#Condition> .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasCost
:hasCost rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasCurvatureDirection
:hasCurvatureDirection rdf:type owl:ObjectProperty ;
                       rdfs:comment "Exclusively used for BCC Curvature of sewer char 1 and 2. Used to describe the horizontal and vertical direction of sewer curvature." .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasDamage
:hasDamage rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasDamageCause
:hasDamageCause rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Defect ;
                rdfs:range :Cause .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasDamageOrientation
:hasDamageOrientation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdf:type owl:FunctionalProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :Defect ;
                      rdfs:range :Orientation .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasFeature
:hasFeature rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasFinishNodeType
:hasFinishNodeType rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasNodeType ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:comment "Exclusively made for BCE Finish node type." .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasHorizontalCurvatureDirection
:hasHorizontalCurvatureDirection rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :hasCurvatureDirection .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasInventoryFeature
:hasInventoryFeature rdf:type owl:ObjectProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:range :Inventory .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:comment "As of now exclusively used to describe location of Vermin. Has potential to further describe other codes however." .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasNodeDamage
:hasNodeDamage rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDamage ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasNodeFabricDamage
:hasNodeFabricDamage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasNodeDamage ;
                     rdf:type owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasNodeFeature
:hasNodeFeature rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasFeature ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasNodeInventoryFeature
:hasNodeInventoryFeature rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasInventoryFeature ;
                         rdfs:range :Inventory .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasNodeType
:hasNodeType rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasObstructionReason
:hasObstructionReason rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasPipeDamage
:hasPipeDamage rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDamage ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasPipeFabricDamage
:hasPipeFabricDamage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasPipeDamage ;
                     rdf:type owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasPipeFeature
:hasPipeFeature rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasFeature ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasPipeInventoryFeature
:hasPipeInventoryFeature rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasInventoryFeature ;
                         rdfs:range :Inventory .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasPipeOperationDamage
:hasPipeOperationDamage rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasPipeDamage ;
                        rdf:type owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasStartNodeType
:hasStartNodeType rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasNodeType ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:comment "Exclusively made for BCD Start node type." .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasTerminationReason
:hasTerminationReason rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasVerticalCurvatureDirection
:hasVerticalCurvatureDirection rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :hasCurvatureDirection .


###  http://www.semanticweb.org/jluis/ontologies/sdco#hasWater
:hasWater rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty .


###  https://l-jamora.github.io/m150-onto#inspectedIn
<https://l-jamora.github.io/m150-onto#inspectedIn> rdf:type owl:ObjectProperty ;
                                                   owl:inverseOf <https://l-jamora.github.io/m150-onto#inspects> ;
                                                   rdf:type owl:AsymmetricProperty ,
                                                            owl:IrreflexiveProperty ;
                                                   rdfs:domain <https://l-jamora.github.io/m150-onto#Component> ;
                                                   rdfs:range <https://l-jamora.github.io/m150-onto#Report> ;
                                                   rdfs:comment "Used in Class Inspection (Template: [Individual:Inspection[HG001]] inspects [Individual:PipeSection[HG001]])"@en .


###  https://l-jamora.github.io/m150-onto#inspects
<https://l-jamora.github.io/m150-onto#inspects> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf owl:topObjectProperty ;
                                                rdf:type owl:AsymmetricProperty ,
                                                         owl:IrreflexiveProperty ;
                                                rdfs:domain <https://l-jamora.github.io/m150-onto#Report> ;
                                                rdfs:range <https://l-jamora.github.io/m150-onto#Component> ;
                                                rdfs:comment "Inverse of inspectedIn"@en .


###  https://l-jamora.github.io/m150-onto#isChildOf
<https://l-jamora.github.io/m150-onto#isChildOf> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <https://l-jamora.github.io/m150-onto#isParentOf> ;
                                                 rdf:type owl:AsymmetricProperty ,
                                                          owl:IrreflexiveProperty ;
                                                 rdfs:comment "Used for HG012 (Kind von/Child Of [Pipe])"@en ,
                                                              "Used in Class Condition (Template: \"Condition[HG001]_[ConditionStation]_[Code]\" isChildOf Inspection)"@en ,
                                                              "Used in Geometry Objects and Points"@en .


###  https://l-jamora.github.io/m150-onto#isParentOf
<https://l-jamora.github.io/m150-onto#isParentOf> rdf:type owl:ObjectProperty ,
                                                           owl:AsymmetricProperty ,
                                                           owl:IrreflexiveProperty ;
                                                  rdfs:comment "Inverse of isChildOf"@en .


#################################################################
#    Data properties
#################################################################

###  https://l-jamora.github.io/m150-onto#hasCameraSpecificDataPlaceholder
<https://l-jamora.github.io/m150-onto#hasCameraSpecificDataPlaceholder> rdf:type owl:DatatypeProperty ;
                                                                        rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                                        rdfs:range xsd:string .


