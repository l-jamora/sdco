                           owl:hasValue "BDD"
                         ] ;
     rdfs:subClassOf :PipeOther ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFeature ;
                       owl:someValuesFrom :WaterLevel
                     ] ;
     rdfs:comment """The level of !wastewater\" above the invert of the drain or sewer.

Characterisation !The wastewater in the pipe is:  clear effluent (the invert is visible) (A); Use of code discontinued (B);  turbid (C);  coloured (D);  turbid and coloured (E).\"""" ;
     rdfs:label "BDD (Water Level)"@en .


