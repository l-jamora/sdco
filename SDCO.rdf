<https://l-jamora.github.io/m150-onto#hasPipeSectionConditionLocalizedRepair> rdf:type owl:DatatypeProperty ;
                                                                              rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasPipeSectionConditionData> ;
                                                                              rdfs:range xsd:string .


