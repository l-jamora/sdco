###  https://l-jamora.github.io/sdco#BAC
:BAC rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BAC"
                         ] ;
     rdfs:subClassOf :PipeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFabricDamage ;
                       owl:someValuesFrom :BreakOrCollapse
                     ] ;
     rdfs:comment "Break/Collapse" ;
     rdfs:isDefinedBy "DIN EN 13508-2" ;
     rdfs:label "BAC (Break Or Collapse)"@en .


