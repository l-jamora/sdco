###  https://l-jamora.github.io/sdco#BAD2_A
:BAD2_A rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAD
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization2> ;
                                                     owl:hasValue "A"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAD ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :LayerBrickworkOrMasonryVisible
                        ] ;
        owl:disjointWith :BAD2_B ;
        rdfs:label "BAD char2=A (Layer Brickwork Or Masonry Visible)"@en .


