                                                              rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/jluis/ontologies/sdco#AggregateProjectingFromSurface
:AggregateProjectingFromSurface rdf:type owl:Class ;
                                rdfs:subClassOf :Surface .


###  http://www.semanticweb.org/jluis/ontologies/sdco#Angular
:Angular rdf:type owl:Class ;
         rdfs:subClassOf :Orientation .


###  http://www.semanticweb.org/jluis/ontologies/sdco#AnotherObjectLyingInInvert
:AnotherObjectLyingInInvert rdf:type owl:Class ;
                            rdfs:subClassOf :Obstacles .


###  http://www.semanticweb.org/jluis/ontologies/sdco#AreaBasedCost
:AreaBasedCost rdf:type owl:Class ;
               rdfs:subClassOf :Cost .


###  http://www.semanticweb.org/jluis/ontologies/sdco#AtmosphereWithinPipeline
:AtmosphereWithinPipeline rdf:type owl:Class ;
                          rdfs:subClassOf :OtherObservation .


###  http://www.semanticweb.org/jluis/ontologies/sdco#AttachedDeposits
:AttachedDeposits rdf:type owl:Class ;
                  rdfs:subClassOf :OperationalDefect .


###  http://www.semanticweb.org/jluis/ontologies/sdco#AuthorityInstruction
:AuthorityInstruction rdf:type owl:Class ;
                      rdfs:subClassOf :Cause .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAA
:BAA rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BAA"
                         ] ;
     rdfs:subClassOf :PipeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFabricDamage ;
                       owl:someValuesFrom :Deformation
                     ] .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAA_A
:BAA_A rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :BAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "A"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :BAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDamageOrientation ;
                         owl:someValuesFrom :Vertical
                       ] ;
       owl:disjointWith :BAA_B .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAA_B
:BAA_B rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :BAA
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                    owl:hasValue "B"
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :BAA ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDamageOrientation ;
                         owl:someValuesFrom :Horizontal
                       ] .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAB
:BAB rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BAB"
                         ] ;
     rdfs:subClassOf :PipeFabric ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFabricDamage ;
                       owl:someValuesFrom :Fissure
                     ] ;
     rdfs:comment """BAB = Pipe Fissure Damage
Char1: Nature of the Fissure
Char2: Orientation of the Fissure
Quantification: Width in millimeters
Circumferntial Location: Should be recorded""" .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAB1_A
:BAB1_A rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "A"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :SurfaceCrackFissure
                        ] .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAB1_B
:BAB1_B rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "B"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :CrackFissure
                        ] .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAB1_C
:BAB1_C rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://l-jamora.github.io/m150-onto#hasCharacterization1> ;
                                                     owl:hasValue "C"
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPipeFabricDamage ;
                          owl:someValuesFrom :FractureFissure
                        ] .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BAB2_A
:BAB2_A rdf:type owl:Class ;
