:BDA rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BDA"
                         ] ;
     rdfs:subClassOf :PipeOther ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFeature ;
                       owl:someValuesFrom :GeneralPhotograph
                     ] ;
     rdfs:comment "A still photograph has been taken to record the general condition of the drain or sewer and is not related to a particular feature" .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BDB
:BDB rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BDB"
                         ] ;
     rdfs:subClassOf :PipeOther ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFeature ;
                       owl:someValuesFrom :GeneralRemark
                     ] ;
     rdfs:comment "A remark which cannot be included in any other way." .


###  http://www.semanticweb.org/jluis/ontologies/sdco#BDC
:BDC rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty <https://l-jamora.github.io/m150-onto#hasConditionCode> ;
                           owl:hasValue "BDC"
                         ] ;
     rdfs:subClassOf :PipeOther ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasPipeFeature ;
                       owl:someValuesFrom :InspectionTermination
                     ] ;
     rdfs:comment "Characterisation 1\"  The reason for the termination:  obstruction (A);  high water level (B);  equipment failure (C);  !other (Z) – where this is used further details shall be recorded in the remarks section." ,
                  "Characterisation 2 Further characterisation as follows:  inspection objective achieved before reaching finish node (A);  inspection terminated on the instruction of the employing authority (B);  when considered with a previous partial inspection, the inspection of the whole pipeline is complete (C);  when considered with a previous partial inspection, the inspection of the whole pipeline is not complete (D);  when considered with a previous partial inspection, it is not known whether the inspection of the whole pipeline is complete (E);  other (Z) – where this is used further details shall be recorded in the remarks section." ,
                  "The inspection has been terminated before the intended finish node was reached.  Where the reason is due to an obstruction this obstruction shall be coded separately using the appropriate main code.  !NOTE If the inspection is restarted it is a new inspection.\"" .


