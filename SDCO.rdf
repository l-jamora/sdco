                          owl:someValuesFrom :Complex
                        ] .


###  https://l-jamora.github.io/sdco#BAB2_D
:BAB2_D rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
