<https://l-jamora.github.io/m150-onto#hasClassificationDate> rdf:type owl:DatatypeProperty ;
                                                             rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                             rdfs:range xsd:dateTime .


