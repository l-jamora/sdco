<https://l-jamora.github.io/m150-onto#hasClassifier> rdf:type owl:DatatypeProperty ;
                                                     rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                     rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasConditionClassOperationalSafety
<https://l-jamora.github.io/m150-onto#hasConditionClassOperationalSafety> rdf:type owl:DatatypeProperty ;
                                                                          rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                                          rdfs:range xsd:integer .


###  https://l-jamora.github.io/m150-onto#hasConditionClassStructuralStability
<https://l-jamora.github.io/m150-onto#hasConditionClassStructuralStability> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                                            rdfs:range xsd:integer .


###  https://l-jamora.github.io/m150-onto#hasConditionClassTightness
<https://l-jamora.github.io/m150-onto#hasConditionClassTightness> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                                  rdfs:range xsd:integer .


###  https://l-jamora.github.io/m150-onto#hasConditionCode
<https://l-jamora.github.io/m150-onto#hasConditionCode> rdf:type owl:DatatypeProperty ;
                                                        rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                        rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasConditionData
<https://l-jamora.github.io/m150-onto#hasConditionData> rdf:type owl:DatatypeProperty ;
                                                        rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasInspectionData> .


###  https://l-jamora.github.io/m150-onto#hasConnection
<https://l-jamora.github.io/m150-onto#hasConnection> rdf:type owl:DatatypeProperty ;
                                                     rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                     rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasImageName
<https://l-jamora.github.io/m150-onto#hasImageName> rdf:type owl:DatatypeProperty ;
                                                    rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                    rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasInspectionData
<https://l-jamora.github.io/m150-onto#hasInspectionData> rdf:type owl:DatatypeProperty .


###  https://l-jamora.github.io/m150-onto#hasLinearDamage
<https://l-jamora.github.io/m150-onto#hasLinearDamage> rdf:type owl:DatatypeProperty ;
                                                       rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                       rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasLongText
<https://l-jamora.github.io/m150-onto#hasLongText> rdf:type owl:DatatypeProperty ;
                                                   rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> ;
                                                   rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasNodeConditionData
<https://l-jamora.github.io/m150-onto#hasNodeConditionData> rdf:type owl:DatatypeProperty ;
                                                            rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> .


###  https://l-jamora.github.io/m150-onto#hasNodeConditionDepth
<https://l-jamora.github.io/m150-onto#hasNodeConditionDepth> rdf:type owl:DatatypeProperty ;
                                                             rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasNodeConditionData> ;
                                                             rdfs:range xsd:float .


###  https://l-jamora.github.io/m150-onto#hasNodeConditionLocalizedRepair
<https://l-jamora.github.io/m150-onto#hasNodeConditionLocalizedRepair> rdf:type owl:DatatypeProperty ;
                                                                       rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasNodeConditionData> ;
                                                                       rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasNodeConditionShaftArea
<https://l-jamora.github.io/m150-onto#hasNodeConditionShaftArea> rdf:type owl:DatatypeProperty ;
                                                                 rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasNodeConditionData> ;
                                                                 rdfs:range xsd:string .


###  https://l-jamora.github.io/m150-onto#hasPipeSectionConditionData
<https://l-jamora.github.io/m150-onto#hasPipeSectionConditionData> rdf:type owl:DatatypeProperty ;
                                                                   rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasConditionData> .


###  https://l-jamora.github.io/m150-onto#hasPipeSectionConditionLining
<https://l-jamora.github.io/m150-onto#hasPipeSectionConditionLining> rdf:type owl:DatatypeProperty ;
                                                                     rdfs:subPropertyOf <https://l-jamora.github.io/m150-onto#hasPipeSectionConditionData> ;
