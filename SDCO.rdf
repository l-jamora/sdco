                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :BAB ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDamageOrientation ;
                          owl:someValuesFrom :Circumferential
                        ] .


###  https://l-jamora.github.io/sdco#BAB2_C
:BAB2_C rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :BAB
                                                   [ rdf:type owl:Restriction ;
